{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "erasableSyntaxOnly": true, "rewriteRelativeImportExtensions": true,
    "declaration": true, "rootDir": "ts", "outDir": "dist", "newLine": "lf",
    "lib": ["ES2022", "DOM"], "types": [], "skipLibCheck": true
  },
  "include": ["ts"],
  "exclude": ["ts/**/*.test.ts"]
}
